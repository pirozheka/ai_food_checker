# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Ключ с https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Модель с поддержкой vision (см. https://openrouter.ai/models?modality=text+image-%3Etext)
OPENROUTER_MODEL=google/gemini-2.5-flash

# Часовой пояс для подсчёта "за сегодня"
TIMEZONE=Europe/Moscow

# Белый список ID пользователей через запятую. Пустое значение = доступ всем.
ALLOWED_USER_IDS=349106724,1217167250,631012438

# Необязательно: заголовки для рейтинга OpenRouter
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Calorie Bot

# Необязательно: прокси для обхода геоблокировки OpenRouter (пусто = напрямую)
# Формат: http://user:pass@host:port
PROXY_URL=

# Час воскресного отчёта за неделю в локальной зоне (0-23), по умолчанию 20
WEEKLY_REPORT_HOUR=20
